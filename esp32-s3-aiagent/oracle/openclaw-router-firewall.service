[Unit]
Description=Allow only the OpenClaw Docker bridge to reach the private voice router
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/openclaw-router-firewall start
ExecStop=/usr/local/sbin/openclaw-router-firewall stop
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target