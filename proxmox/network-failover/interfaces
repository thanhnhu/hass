# /etc/network/interfaces (Proxmox 192.168.2.100)
# wifi tach khoi bond: vmbr0 dung thang nic0, wifi co IP rieng .101.
# Default route uu tien do net-failover.service quan ly.

auto lo
iface lo inet loopback

# LAN interface
iface nic0 inet manual
	post-up ethtool -s nic0 wol g

iface nic1 inet manual

# Wifi interface (wpa_supplicant@wlp2s0.service lo ket noi)
# Policy routing: goi co src .101 luon tra ve qua wifi.
auto wlp2s0
iface wlp2s0 inet static
	address 192.168.2.101/24
	post-up ip rule add from 192.168.2.101 table 101 || true
	post-up ip route replace 192.168.2.0/24 dev wlp2s0 src 192.168.2.101 table 101
	post-up ip route replace default via 192.168.2.1 dev wlp2s0 table 101
	pre-down ip rule del from 192.168.2.101 table 101 || true

# Network port for Proxmox & VM/LXC
auto vmbr0
iface vmbr0 inet static
	address 192.168.2.100/24
	gateway 192.168.2.1
	bridge-ports nic0
	bridge-stp off
	bridge-fd 0

source /etc/network/interfaces.d/*
